# ---------------------------------------------------------------------------
# CardVault environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed. Every value below is server-side only except the
# variables prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardvault?schema=public"

# Secret used by Auth.js to sign sessions and tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# TCGplayer authorized API access. Leave blank to disable the provider — the app
# will report "TCGplayer integration not configured." rather than invent prices.
TCGPLAYER_CLIENT_ID=
TCGPLAYER_CLIENT_SECRET=
# Optional: defaults to https://api.tcgplayer.com
# TCGPLAYER_API_BASE=
# Optional: partnership sales-history URL template, {productId} replaced (authorized access only)
# TCGPLAYER_SALES_HISTORY_URL_TEMPLATE=

# eBay authorized API access. Leave blank to disable the provider.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production

# Background sync / provider pacing (milliseconds)
# SYNC_JOB_MAX_ATTEMPTS=4
# SYNC_JOB_BASE_DELAY_MS=1000
# SYNC_JOB_MAX_DELAY_MS=60000
# PROVIDER_MIN_INTERVAL_MS=250

# Public base URL of the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
