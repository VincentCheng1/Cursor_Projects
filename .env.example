# ---------------------------------------------------------------------------
# CardVault environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed. Every value below is server-side only except the
# variables prefixed with NEXT_PUBLIC_.
#
# Marketplace rule (spec §5 / §12): leave TCGplayer / eBay blank to disable
# those providers. The app fails closed — no invented cards, sales, or prices.
# After you set credentials, restart the Node process, then use admin
# diagnostics → “Check sync readiness” (dry-run) → “Run public data sync”.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardvault?schema=public"

# Secret used by Auth.js to sign sessions and tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- TCGplayer (authorized API) ---------------------------------------------
# Required together to enable TCGplayer catalog ingest + sales history:
TCGPLAYER_CLIENT_ID=
TCGPLAYER_CLIENT_SECRET=
# Optional: defaults to https://api.tcgplayer.com
# TCGPLAYER_API_BASE=
# Optional: partnership sales-history URL template; `{productId}` is replaced.
# Use only when your credential tier documents a different authorized endpoint.
# TCGPLAYER_SALES_HISTORY_URL_TEMPLATE=
# Optional: game slug → TCGplayer category id map for public catalog ingest
# TCGPLAYER_CATEGORY_MAP=pokemon:3,one-piece:68

# --- eBay (authorized API) --------------------------------------------------
# Required together to enable eBay taxonomy / catalog links / completed sales:
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production | sandbox
EBAY_ENVIRONMENT=production

# --- The Card API (TCA) — eBay completed-sales replacement -------------------
# Prefer for EBAY pricing slot sold comps when set (header: x-market-api-key).
# Keys are prefixed tca_. Leave blank to disable; fail closed — no invented sales.
# Docs: https://www.thecardapi.com/docs
TCA_API_KEY=
# Optional override (default https://www.thecardapi.com/api/v1/market)
# TCA_API_BASE=

# --- Background sync / provider pacing --------------------------------------
# SYNC_JOB_MAX_ATTEMPTS=4
# SYNC_JOB_BASE_DELAY_MS=1000
# SYNC_JOB_MAX_DELAY_MS=60000
# PROVIDER_MIN_INTERVAL_MS=250
# Admin “Run public data sync” cooldown (default 15 minutes)
# PUBLIC_DATA_SYNC_COOLDOWN_MS=900000

# Public base URL of the app (no trailing slash).
# Local: http://localhost:3000
# Production canonical host: https://vinnystracker.com
# Also set AUTH_URL to the same origin in production (Auth.js); trustHost is enabled.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# AUTH_URL=https://vinnystracker.com

